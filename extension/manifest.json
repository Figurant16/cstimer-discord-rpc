{
  "manifest_version": 3,
  "name": "csTimer Discord RPC",
  "version": "1.0.0",
  "description": "Affiche ao5, ao12 et le dernier temps de csTimer dans le statut Discord.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://cstimer.net/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://cstimer.net/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
