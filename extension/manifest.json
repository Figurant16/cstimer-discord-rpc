{
  "manifest_version": 3,
  "name": "csTimer Discord RPC",
  "version": "1.0.0",
  "description": "Shows your csTimer ao5, ao12 and last solve in your Discord status.",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "action": { "default_title": "csTimer Discord RPC", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://cstimer.net/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://cstimer.net/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
